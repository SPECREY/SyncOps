{
  "name": "sync-ops",
  "version": "1.0.0",
  "description": "Daily task launcher for learning game development, designed for ADHD",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder --linux AppImage"
  },
  "author": "SyncOps",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "dseg": "^0.46.0"
  },
  "productName": "SyncOps",
  "build": {
    "appId": "app.syncops",
    "productName": "SyncOps",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "build/icon.png"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "SyncOps.AppImage"
    },
    "publish": null,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true,
      "artifactName": "SyncOps-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SyncOps"
    }
  }
}
